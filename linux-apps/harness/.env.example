# 在本目录复制为 .env 后填写个人配置：cp .env.example .env
# main.py 自动加载 .env，并覆盖同名进程环境变量；米家 MCP 也读取此文件。

# 会话结束时额外保存完整消息到 data/*.jsonl，默认关闭；设为 true 开启。
DEBUG=false

# 同机部署的 ASR 服务。
ASR_SERVER_WS_URL=ws://127.0.0.1:8086/ws

# OpenAI 兼容接口；下列示例与米家 MCP 的 DeepSeek 默认配置配套。
# 对话、看摄像头和 AI 日记共用同一模型，需支持图片输入。更换供应商时同时修改接口地址和模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# TTS 引擎在 Web 配置台选择，保存在 config.json。
# 默认 bytedancev1；豆包 v1/v2 均使用以下凭据。
# 选择 edge 时无需 TTS 凭据；选择 mimo 时填写下方 MIMO_API_KEY。
BYTEDANCE_TTS_APP_ID=
BYTEDANCE_TTS_APP_KEY=

# 小米 MiMo TTS，仅选择 mimo 时使用。
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_VOICE=mimo_default
MIMO_TTS_INSTRUCTIONS=
