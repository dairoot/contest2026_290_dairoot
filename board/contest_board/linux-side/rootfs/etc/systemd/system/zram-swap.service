[Unit]
Description=zram swap (zram built into kernel, no module to modprobe)
DefaultDependencies=no
After=local-fs.target
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec "echo zstd > /sys/block/zram0/comp_algorithm; echo 3G > /sys/block/zram0/disksize; mkswap /dev/zram0 >/dev/null; swapon -p 100 /dev/zram0"
ExecStop=/bin/sh -ec "swapoff /dev/zram0; echo 1 > /sys/block/zram0/reset"

[Install]
WantedBy=multi-user.target
