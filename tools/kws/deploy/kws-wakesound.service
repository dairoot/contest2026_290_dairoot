[Unit]
Description=Ding-dong feedback on openvela wake-word detections
After=multi-user.target sound.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/kickpi/wake_watch.py --exec "aplay -D plughw:rockchipes8388,0 /home/kickpi/ding.wav"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
